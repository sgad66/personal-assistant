{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": ".test-build",
    "noEmit": false,
    "types": ["node"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "src/shared/**/*.ts",
    "src/main/**/*.ts",
    "src/renderer/input-collector.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/helpers/**/*.ts"
  ]
}